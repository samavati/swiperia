{
  "name": "swiperia-core",
  "version": "1.1.1",
  "description": "Platform-agnostic engine for swipe gestures: direction, distance, velocity and movement analysis.",
  "keywords": [
    "swipe",
    "gesture",
    "touch",
    "mobile",
    "javascript",
    "typescript",
    "ui",
    "interaction"
  ],
  "homepage": "https://github.com/samavati/swiperia#readme",
  "bugs": {
    "url": "https://github.com/samavati/swiperia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samavati/swiperia.git",
    "directory": "packages/swiperia-core"
  },
  "license": "MIT",
  "author": "Ehsan Samavati",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "swiperia-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "nx": {
    "tags": [
      "scope:core"
    ],
    "targets": {
      "build": {
        "command": "tsc --build tsconfig.lib.json && tsup",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
