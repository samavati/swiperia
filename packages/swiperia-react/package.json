{
  "name": "swiperia-react",
  "version": "1.1.2",
  "description": "React bindings for Swiperia: a SwipeArea component and a useSwiperia hook for swipe gestures.",
  "keywords": [
    "swipe",
    "gesture",
    "touch",
    "mobile",
    "react",
    "react-hook",
    "typescript",
    "ui",
    "interaction"
  ],
  "homepage": "https://github.com/samavati/swiperia#readme",
  "bugs": {
    "url": "https://github.com/samavati/swiperia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samavati/swiperia.git",
    "directory": "packages/swiperia-react"
  },
  "license": "MIT",
  "author": "Ehsan Samavati",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "swiperia-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "swiperia-core": "1.1.2",
    "swiperia-js": "1.1.2",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "nx": {
    "tags": [
      "scope:react"
    ],
    "targets": {
      "build": {
        "command": "tsc --build tsconfig.lib.json && tsup",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
